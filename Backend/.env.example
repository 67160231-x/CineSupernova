# Supabase Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# ใช้ "service_role" key (ไม่ใช่ anon/publishable key) เพราะ backend นี้ต้อง bypass RLS ได้
# ห้าม commit ค่านี้ขึ้น git และห้ามส่งไปฝั่ง frontend เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---------- ลืมรหัสผ่าน (ส่งอีเมลลิงก์ตั้งรหัสผ่านใหม่) ----------
# ที่อยู่เว็บที่ผู้ใช้เปิดจริง (ลิงก์ในอีเมลจะขึ้นต้นด้วยค่านี้) เช่น https://cinesupernova.vercel.app
# ถ้าไม่ตั้งและ host บน Render ระบบจะใช้ RENDER_EXTERNAL_URL ให้อัตโนมัติ / รันในเครื่องจะใช้ http://localhost:3000
APP_BASE_URL=

# ผู้ให้บริการส่งอีเมล เลือกอย่างใดอย่างหนึ่ง (แนะนำ Brevo เพราะส่งหาใครก็ได้ ไม่ต้องมีโดเมนของตัวเอง)
# Brevo: สร้าง API key + ยืนยันอีเมลผู้ส่ง (Sender) แล้วใส่สองค่านี้
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CineSupernova
# หรือ Resend (ถ้ายังไม่ยืนยันโดเมน จะส่งได้เฉพาะอีเมลของเจ้าของบัญชี Resend)
# RESEND_API_KEY=

# โหมดสาธิต: true = หน้าเว็บจะโชว์ลิงก์รีเซ็ตให้กดเลย (ไม่ต้องรออีเมล) ใช้ตอนเดโม/ทดสอบเท่านั้น
# ⚠️ ห้ามเปิดบนเว็บจริง เพราะใครก็ขอลิงก์รีเซ็ตของบัญชีอื่นได้
PASSWORD_RESET_DEMO=false
