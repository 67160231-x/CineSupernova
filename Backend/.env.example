# ============================================================================
# CineSupernova — ตัวอย่าง Environment (คัดลอกเป็นไฟล์ .env สำหรับรันในเครื่อง)
# บน Render ให้ไปตั้งค่าเดียวกันนี้ที่ Dashboard > Environment แทน (ไฟล์ .env ไม่ถูกอัปขึ้น GitHub)
# ============================================================================

# ---------- Supabase (บังคับ) ----------
# Supabase Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# ใช้ "service_role" key (ไม่ใช่ anon/publishable key) เพราะ backend นี้ต้อง bypass RLS ได้
# ห้าม commit ค่านี้ขึ้น git และห้ามส่งไปฝั่ง frontend เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---------- Admin (บังคับ ถ้าจะใช้หน้า /admin.html) ----------
ADMIN_USERNAME=admin
# อย่างน้อย 8 ตัวอักษร — เปลี่ยนค่านี้เมื่อไหร่ admin ที่ล็อกอินค้างไว้จะถูกเตะออกทันที
ADMIN_PASSWORD=change-me-to-a-strong-password
# (ไม่บังคับ) ล็อกอิน admin หนึ่งครั้งอยู่ได้กี่ชั่วโมง (ค่าเริ่มต้น 8)
# ADMIN_SESSION_HOURS=8

# ---------- ลืมรหัสผ่าน (ส่งอีเมลลิงก์ตั้งรหัสผ่านใหม่) ----------
# ที่อยู่เว็บที่ผู้ใช้เปิดจริง (ลิงก์ในอีเมลจะขึ้นต้นด้วยค่านี้) เช่น https://cine-supernova.vercel.app
# ตั้งชื่อ APP_URL หรือ APP_BASE_URL ก็ได้ (ใช้ได้ทั้งคู่)
# ถ้าไม่ตั้งและ host บน Render ระบบจะใช้ RENDER_EXTERNAL_URL ให้อัตโนมัติ / รันในเครื่องจะใช้ http://localhost:3000
APP_URL=

# ผู้ให้บริการส่งอีเมล เลือกอย่างใดอย่างหนึ่ง
# ทางเลือก A (แนะนำ ฟรี ไม่ต้องมีโดเมน): Gmail ผ่าน Google Apps Script — วิธีติดตั้งดูใน Backend/email/gmail-relay.gs
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=
# ทางเลือก B: Brevo — สร้าง API key + ยืนยันอีเมลผู้ส่ง (Sender) แล้วใส่สองค่านี้
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=
# ทางเลือก C: Resend (ถ้ายังไม่ยืนยันโดเมน จะส่งได้เฉพาะอีเมลของเจ้าของบัญชี Resend)
# RESEND_API_KEY=
MAIL_FROM_NAME=CineSupernova

# โหมดสาธิต: true = หน้าเว็บจะโชว์ลิงก์รีเซ็ตให้กดเลย (ไม่ต้องรออีเมล) ใช้ตอนเดโม/ทดสอบเท่านั้น
# ⚠️ ห้ามเปิดบนเว็บจริง เพราะใครก็ขอลิงก์รีเซ็ตของบัญชีอื่นได้
PASSWORD_RESET_DEMO=false

# ---------- (ไม่บังคับ) ค้นหาโปสเตอร์อัตโนมัติจาก TMDB ----------
# สมัครฟรีที่ https://www.themoviedb.org/settings/api (ใช้ได้ทั้ง API Key หรือ API Read Access Token)
# TMDB_API_KEY=

# ---------- (ไม่บังคับ) ชื่อ Supabase Storage bucket เก็บรูป ----------
# POSTER_BUCKET=posters
