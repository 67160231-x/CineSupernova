# Supabase Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# ใช้ "service_role" key (ไม่ใช่ anon/publishable key) เพราะ backend นี้ต้อง bypass RLS ได้
# ห้าม commit ค่านี้ขึ้น git และห้ามส่งไปฝั่ง frontend เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d
