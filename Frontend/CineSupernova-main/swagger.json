          {
            "adminAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        }
      }
    },
    "/api/admin/test-email": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "ส่งเมลทดสอบ",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to": {
                    "type": "string"
                  }
                },
                "required": [
                  "to"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        }
      }
    },
    "/api/admin/stats": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "สถิติภาพรวม",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        }
      }
    },
    "/api/admin/movies": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "รายการหนัง (ค้นหา/กรองตามรูป/แบ่งหน้า)",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "poster",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "missing",
                "has"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        }
      },
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "เพิ่มหนังใหม่",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "genre": {
                    "type": "string"
                  },
                  "year": {
                    "type": "integer"
                  },
                  "score": {
                    "type": "number"
                  },
                  "director": {
                    "type": "string"
                  },
                  "star": {
                    "type": "string"
                  },
                  "synopsis": {
                    "type": "string"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "posterClass": {
                    "type": "string"
                  },
                  "icon": {
                    "type": "string"
                  }
                },
                "required": [
                  "title"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "สร้างแล้ว"
          },
          "400": {
            "description": "ข้อมูลไม่ถูกต้อง"
          }
        }
      }
    },
    "/api/admin/movies/{id}": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "ข้อมูลหนัง",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
