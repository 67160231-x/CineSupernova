{
  "openapi": "3.0.0",
  "info": {
    "title": "CineSupernova API",
    "version": "1.0.0",
    "description": "เอกสารและทดสอบระบบ REST API สำหรับโปรเจกต์ CineSupernova"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health Check",
        "responses": {
          "200": {
            "description": "ระบบทำงานปกติ"
          }
        }
      }
    },
    "/api/check-username/{name}": {
      "get": {
        "summary": "ตรวจสอบชื่อผู้ใช้ซ้ำ",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        }
      }
    },
    "/api/movies": {
      "get": {
        "summary": "ดึงรายการภาพยนตร์ทั้งหมด",
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "เข้าสู่ระบบ",
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        }
      }
    },
    "/api/recommendations": {
      "get": {
        "summary": "หนังแนะนำเฉพาะผู้ใช้ (เรียนรู้จากการเปิดดู/Watchlist/รีวิว/ไม่สนใจ)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24,
              "default": 12
            }
          }
        ],
        "responses": {
          "200": {
            "description": "personalized=false หมายถึงผู้ใช้ใหม่ ยังไม่มีข้อมูลรสนิยม (โชว์หนังคะแนนสูงทั่วไป) แต่ละเรื่องมี reason/reasonType บอกเหตุผลที่แนะนำ"
          },
          "401": {
            "description": "ยังไม่ล็อกอิน"
          }
        }
      }
    },
    "/api/recommendations/dismiss": {
      "post": {
        "summary": "กด \"ไม่สนใจ\" หนังที่แนะนำ (จะไม่ถูกแนะนำอีก)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "movieId": {
                    "type": "integer"
                  }
                },
                "required": [
                  "movieId"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "สำเร็จ"
          },
          "404": {
            "description": "ไม่พบหนัง"
          },
          "503": {
            "description": "ยังไม่ได้รัน migration_recommendations.sql"
          }
        }
      }
    },
    "/api/taste-profile": {
      "get": {
        "summary": "สรุปรสนิยมหนังของผู้ใช้ (แนว/ผู้กำกับ/นักแสดง/ยุคที่ชอบ)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "สำเร็จ"
          },
          "401": {
            "description": "ยังไม่ล็อกอิน"
          }
        }
      }
    },
    "/api/views": {
      "post": {
        "summary": "บันทึกว่าผู้ใช้เปิดดูหนังเรื่องนี้ (ใช้เรียนรู้รสนิยม)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "movieId": {
                    "type": "integer"
                  }
                },
                "required": [
                  "movieId"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "สำเร็จ"
          },
          "404": {
            "description": "ไม่พบหนัง"
          }
        }
      }
    },
    "/api/movies/{id}/similar": {
      "get": {
        "summary": "หนังที่คล้ายกับเรื่องนี้ (ไม่ต้องล็อกอิน)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 4,
              "maximum": 12
            }
          }
        ],
        "responses": {
          "200": {
            "description": "สำเร็จ"
          },
          "404": {
            "description": "ไม่พบหนัง"
          }
        }
      }
    },
    "/api/forgot-password": {
      "post": {
        "summary": "ลืมรหัสผ่าน: ขอลิงก์ตั้งรหัสผ่านใหม่ทางอีเมล (ตอบข้อความเดียวกันเสมอ ไม่บอกว่ามีอีเมลนี้ในระบบหรือไม่)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "example@email.com"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "รับคำขอแล้ว"
          },
          "400": {
            "description": "อีเมลว่างหรือรูปแบบไม่ถูกต้อง"
          },
          "429": {
            "description": "ขอบ่อยเกินไป"
          }
        }
      }
    },
    "/api/reset-password/check": {
      "get": {
        "summary": "เช็คว่าลิงก์รีเซ็ตรหัสผ่านยังใช้ได้ไหม",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{ valid: true | false }"
          }
        }
      }
    },
    "/api/reset-password": {
      "post": {
        "summary": "ตั้งรหัสผ่านใหม่ด้วย token จากอีเมล (ใช้ได้ครั้งเดียว อายุ 30 นาที) และเตะทุกอุปกรณ์ออกจากระบบ",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "newPassword": {
                    "type": "string",
                    "minLength": 6
                  }
                },
                "required": [
                  "token",
                  "newPassword"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ตั้งรหัสผ่านใหม่สำเร็จ"
          },
          "400": {
            "description": "ลิงก์ไม่ถูกต้อง/หมดอายุ หรือรหัสผ่านสั้นเกินไป"
          }
        }
      }
    },
    "/api/admin/login": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "เข้าสู่ระบบ Admin (ADMIN_USERNAME / ADMIN_PASSWORD จาก Environment)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "สำเร็จ"
          },
          "401": {
            "description": "รหัสไม่ถูกต้อง"
          },
          "429": {
            "description": "ใส่ผิดเกิน 5 ครั้งใน 15 นาที"
          },
          "503": {
            "description": "ยังไม่ได้ตั้ง ADMIN_PASSWORD"
          }
        }
      }
    },
    "/api/admin/me": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "ข้อมูล session ของ admin",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        }
      }
