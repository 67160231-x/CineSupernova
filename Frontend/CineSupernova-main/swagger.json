        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        }
      },
      "put": {
        "tags": [
          "Admin"
        ],
        "summary": "แก้ไขข้อมูลหนัง (ส่งเฉพาะ field ที่จะแก้)",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "genre": {
                    "type": "string"
                  },
                  "year": {
                    "type": "integer"
                  },
                  "score": {
                    "type": "number"
                  },
                  "synopsis": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        }
      },
      "delete": {
        "tags": [
          "Admin"
        ],
        "summary": "ลบหนัง (พร้อมรูปใน Storage)",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        }
      }
    },
    "/api/admin/movies/{id}/poster": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "ตั้งรูปโปสเตอร์: อัปโหลดไฟล์ (image = data URL base64) หรือใช้ลิงก์ (url)",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "example": "data:image/webp;base64,UklGR..."
                  },
                  "url": {
                    "type": "string",
                    "example": "https://image.tmdb.org/t/p/w500/xxx.jpg"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "สำเร็จ"
          },
          "400": {
            "description": "ไฟล์ไม่ใช่รูป / ลิงก์ไม่ถูกต้อง"
          },
          "413": {
            "description": "ไฟล์ใหญ่เกินไป"
          }
        }
      },
      "delete": {
        "tags": [
          "Admin"
        ],
        "summary": "ลบรูปโปสเตอร์",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        }
      }
    },
